{
  "info": {
    "name": "Gimnasio API - Instructors",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [{ "key": "baseUrl", "value": "http://localhost:3000" }],
  "item": [
    {
      "name": "GET /instructors (200)",
      "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/instructors", "host": ["{{baseUrl}}"], "path": ["instructors"] } }
    },
    {
      "name": "GET /instructors/1 (200)",
      "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/instructors/1", "host": ["{{baseUrl}}"], "path": ["instructors", "1"] } }
    },
    {
      "name": "GET /instructors/999 (404)",
      "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/instructors/999", "host": ["{{baseUrl}}"], "path": ["instructors", "999"] } }
    }
  ]
}
